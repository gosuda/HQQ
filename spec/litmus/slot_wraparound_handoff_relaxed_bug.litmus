C hqq_slot_wraparound_handoff_relaxed_bug
(* NEGATIVE test: the consumer's release of the slot is relaxed. The producer's
   lap-1 payload write may then be observed by the consumer's payload read
   (the consumer's read is not ordered before its own relaxed store as seen by
   the producer). Expected herd7 result: "Sometimes" or a data-race flag. *)
{ }

P0 (atomic_int* seq, int* d) {
  *d = 1;
  atomic_store_explicit(seq, 1, memory_order_release);
  int r1 = atomic_load_explicit(seq, memory_order_acquire);
  if (r1 == 2) {
    *d = 2;
  }
}

P1 (atomic_int* seq, int* d) {
  int r0 = atomic_load_explicit(seq, memory_order_acquire);
  int r2 = 0;
  if (r0 == 1) {
    r2 = *d;
    atomic_store_explicit(seq, 2, memory_order_relaxed);
  }
}

exists (1:r0=1 /\ 1:r2=2)
