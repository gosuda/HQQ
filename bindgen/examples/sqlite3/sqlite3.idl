// sqlite3.idl: the subset of the SQLite C API that a database/sql driver needs, for hqq-bindgen.
// README.md says what is exposed, what is deliberately not, and how the policy of the server maps
// to the hand-written hqq-sqlite server (examples/sqlite/server).
//
// Threading. SQLite 3.x built with SQLITE_THREADSAFE=1 is safe when every connection is used by one
// thread at a time, and a session is one server thread that owns its connections and statements.
// The service is therefore @serialize(none). @serialize(session) would be wrong, not only slow: it
// holds one lock around every library call of every session, so a session that waits inside
// sqlite3_step for a busy-timeout would hold the lock that the session it waits for needs to run
// its COMMIT, and the busy timeout could only ever expire.
//
// Error convention. Functions that return a SQLite result code are @error(status, ...). The Go
// error of a failure is a *rt.LibError whose Code is the code that SQLite returned (the extended
// code: the server enables sqlite3_extended_result_codes on every connection) and whose Detail is
// the connection's error message. Codes of this service that SQLite never returns are the
// SVC_* consts below.
//
// Shims (declared with `shim`) are in server/sqlite3_hooks.c.
idl 1;

@serialize(none)
service sqlite3;

include "sqlite3.h";

// Result codes and open flags (sqlite3.h).
const SQLITE_OK: i32 = 0;
const SQLITE_ROW: i32 = 100;
const SQLITE_DONE: i32 = 101;
const SQLITE_OPEN_READONLY: i32 = 1;
const SQLITE_OPEN_READWRITE: i32 = 2;
const SQLITE_OPEN_CREATE: i32 = 4;

// Codes that SQLite does not return. A prepare_one failure of these two kinds is the BAD_REQUEST of
// sqlite/PROTOCOL.md 6.2 ("multiple statements", "empty statement"); SVC_BAD_ARGS is a bulk bind or
// exec_stmt whose arrays disagree (the shim cannot trust the client's encoding).
const SVC_SQL_EMPTY: i32 = 16777217;
const SVC_SQL_MULTIPLE: i32 = 16777218;
const SVC_BAD_ARGS: i32 = 16777219;

// Application statuses of the interceptor and of the shims (the 0x0100..0xFFFF range of BINDGEN.md
// 4.10). Status 0x0100 + n for a SQLite primary result code n < 256 means "the open failed with
// SQLITE_<n> before SQLite was called" (0x010E, SQLITE_CANTOPEN, when the parent directory of the
// database does not exist). The names below are for the Go side; the C side has the same numbers.
const SVC_STATUS_SQLITE_BASE: u32 = 256;
const SVC_STATUS_META_TOO_LARGE: u32 = 4096;
const SVC_STATUS_NAME_TOO_LONG: u32 = 4097;

// Limits that mirror sqlite/PROTOCOL.md section 11.
const SVC_MAX_SQL: u32 = 1048576;
const SVC_MAX_PATH: u32 = 4096;
const SVC_MAX_NAME: u32 = 1024;
const SVC_MAX_PARAMS: u32 = 32766;
const SVC_MAX_COLUMNS: u32 = 2000;
const SVC_MAX_FETCH_ROWS: i32 = 4096;
const SVC_DEFAULT_FETCH_ROWS: i32 = 256;
// Largest text or blob that one request can bind, bound by the default max_message of 16 MiB.
const SVC_MAX_BIND_BYTES: u32 = 16776960;
// Largest piece of a text or blob that column_chunk returns in one call.
const SVC_MAX_CHUNK: u32 = 1048576;
// Response bound of fetch_rows (the @max_out below).
const SVC_FETCH_BOUND: u32 = 65536;
// Response bound of stmt_info.
const SVC_INFO_BOUND: u32 = 1048576;

@c("sqlite3 *")
handle Db destroy sqlite3_close;

@c("sqlite3_stmt *")
handle Stmt owned_by Db destroy sqlite3_finalize;

// One result cell. Int, Float, Text, Blob and Null are the SQLite fundamental types (the tags of
// sqlite3_column_type are 1..5). TextRaw is a TEXT value that contains a NUL byte, which a wire str
// cannot carry; its bytes are the text. BigText and BigBlob stand for a TEXT or BLOB value that did
// not fit the batch: the payload is its length in bytes, and column_chunk reads it.
union Value {
    case 1 Int: i64;
    case 2 Float: f64;
    case 3 Text: str;
    case 4 Blob: bytes;
    case 5 Null;
    case 6 TextRaw: bytes;
    case 7 BigText: u64;
    case 8 BigBlob: u64;
}

// The result of fetch_rows. rc is SQLITE_ROW when the batch ended and the statement has more rows
// (or may have: the shim never steps to look ahead), SQLITE_DONE when the statement finished, and
// the (extended) error code of the failing sqlite3_step otherwise; the rows that were read before
// the failure are still in cells. cells holds len(cells) / ncols rows in row-major order. errmsg is
// written after the cells, because the failure comes after the rows; it is empty unless rc is an
// error.
struct Rows {
    rc: i32;
    ncols: u32;
    cells: Value[];
    errmsg: str<=1024;
}

struct Column {
    name: str<=1024;
    decltype: str<=1024;
}

// Everything a driver asks of a freshly prepared statement, in one call. param_names has nparams
// entries: the name as SQLite spells it (":id", "@id", "$id", "?5") or "" for a plain "?".
struct StmtMeta {
    nparams: u32;
    readonly: bool;
    param_names: str[]<=SVC_MAX_PARAMS;
    columns: Column[]<=SVC_MAX_COLUMNS;
}

// ---- Connections -----------------------------------------------------------------------------

// The interceptor (server/sqlite3_hooks.c) applies the path policy of the hand-written server
// (examples/sqlite/server/src/sqlsrv_policy.c and sqlsrv_pathrules.c, compiled into this server):
// filename is an alias or a path inside the allow directory, flags are exactly one of READONLY and
// READWRITE plus optionally CREATE (no URI, no cache or mutex flags), and zvfs must be NULL. A
// refusal is E_DENIED. Every connection that this process opens gets the connection setup of
// sqlite3_hooks.c (limits, no extension loading, an authorizer that denies ATTACH and DETACH,
// extended result codes) through sqlite3_auto_extension.
@intercept
@error(status, ok(SQLITE_OK), detail(db_errmsg, db))
fn sqlite3_open_v2(filename: str<=SVC_MAX_PATH, out db: Db, flags: i32, zvfs: str<=64 @nullable) -> i32;

// sqlite3_close answers SQLITE_BUSY while statements, backups or blob handles are open and then keeps
// the connection. The server finalizes the statements of the session first (the children of a Db,
// BINDGEN.md 5.1), so the only way to see BUSY is a library bug; the annotation is the documented
// safety net.
@retain_on_fail
@error(status, ok(SQLITE_OK))
fn sqlite3_close(db: Db) -> i32;

@error(status, ok(SQLITE_OK), detail(db_errmsg, db))
fn sqlite3_busy_timeout(db: Db, ms: i32) -> i32;

fn sqlite3_changes64(db: Db) -> i64;
fn sqlite3_last_insert_rowid(db: Db) -> i64;
fn sqlite3_get_autocommit(db: Db) -> i32;
fn sqlite3_errcode(db: Db) -> i32;
fn sqlite3_extended_errcode(db: Db) -> i32;
fn sqlite3_errmsg(db: Db) -> str<=SVC_MAX_NAME;

fn sqlite3_libversion_number() -> i32;
fn sqlite3_libversion() -> str<=32;

// ---- Statements ------------------------------------------------------------------------------

// The raw prepare: it compiles the first statement of sql, returns the offset of the rest in tail,
// and answers a NULL statement (the nil Stmt) for empty or comment-only SQL. Use it to run a script
// statement by statement.
@error(status, ok(SQLITE_OK), detail(db_errmsg, db))
fn sqlite3_prepare_v2(db: Db, sql: str<=SVC_MAX_SQL, nbyte: i32 @len_of(sql),
                      out stmt: Stmt, out tail: u32 @offset_in(sql)) -> i32;

// Prepare of exactly one statement, the rule of sqlite/PROTOCOL.md 6.2: trailing text other than
// white space and ';' fails with SVC_SQL_MULTIPLE, SQL without a statement with SVC_SQL_EMPTY; both
// leave no statement behind. Otherwise it is sqlite3_prepare_v2.
@error(status, ok(SQLITE_OK), detail(prep_errmsg, db))
shim fn prepare_one(db: Db, sql: str<=SVC_MAX_SQL, nbyte: i32 @len_of(sql), out stmt: Stmt) -> i32;

@error(status, ok(SQLITE_ROW, SQLITE_DONE), detail(stmt_errmsg, stmt))
fn sqlite3_step(stmt: Stmt) -> i32;

@error(status, ok(SQLITE_OK), detail(stmt_errmsg, stmt))
fn sqlite3_reset(stmt: Stmt) -> i32;

// sqlite3_finalize returns the error of the last step but always frees the statement (BINDGEN.md 5.1).
@error(status, ok(SQLITE_OK))
fn sqlite3_finalize(stmt: Stmt) -> i32;

@error(status, ok(SQLITE_OK))
fn sqlite3_clear_bindings(stmt: Stmt) -> i32;

fn sqlite3_stmt_readonly(stmt: Stmt) -> i32;

// ---- Parameters ------------------------------------------------------------------------------

fn sqlite3_bind_parameter_count(stmt: Stmt) -> i32;
fn sqlite3_bind_parameter_index(stmt: Stmt, name: str<=SVC_MAX_NAME) -> i32;
fn sqlite3_bind_parameter_name(stmt: Stmt, index: i32) -> str<=SVC_MAX_NAME @nullable;

@error(status, ok(SQLITE_OK), detail(stmt_errmsg, stmt))
fn sqlite3_bind_int64(stmt: Stmt, index: i32, value: i64) -> i32;

@error(status, ok(SQLITE_OK), detail(stmt_errmsg, stmt))
fn sqlite3_bind_double(stmt: Stmt, index: i32, value: f64) -> i32;

@error(status, ok(SQLITE_OK), detail(stmt_errmsg, stmt))
fn sqlite3_bind_null(stmt: Stmt, index: i32) -> i32;

@error(status, ok(SQLITE_OK), detail(stmt_errmsg, stmt))
fn sqlite3_bind_zeroblob64(stmt: Stmt, index: i32, n: u64) -> i32;

// sqlite3_bind_text64 and sqlite3_bind_blob64 take a destructor argument. The shims bind a copy
// (SQLITE_TRANSIENT), so the request slot is not retained. The text is bytes, not str: SQLite text
// may contain NUL bytes, which a wire str cannot carry. A zero-length blob binds as zeroblob(0).
@error(status, ok(SQLITE_OK), detail(stmt_errmsg, stmt))
shim fn bind_text(stmt: Stmt, index: i32, text: bytes<=SVC_MAX_BIND_BYTES, n: size @len_of(text)) -> i32;

@error(status, ok(SQLITE_OK), detail(stmt_errmsg, stmt))
shim fn bind_blob(stmt: Stmt, index: i32, data: bytes<=SVC_MAX_BIND_BYTES, n: size @len_of(data)) -> i32;

// Resets the statement, clears its bindings (sqlite3_reset, sqlite3_clear_bindings) and binds positions
// 1..nkinds, in one call. The reset is what makes it usable on a statement that has run: SQLite refuses a
// bind on a statement that has not been reset (SQLITE_MISUSE). A tagged-value array is a composite
// in-parameter, which BINDGEN.md V38 forbids, so the values arrive as three arrays of fixed-size
// elements:
//   kinds[i]  1 integer, 2 float, 3 text, 4 blob, 5 null, 6 zeroblob
//   words[i]  integer: the value; float: its IEEE 754 bit pattern; text, blob, zeroblob: the length
//   data      the bytes of the text and blob values, in order, nothing else
// kinds and words have the same length, at most SVC_MAX_PARAMS, and the lengths of the text and blob
// values add up to len(data); anything else fails with SVC_BAD_ARGS before SQLite is called.
@error(status, ok(SQLITE_OK), detail(stmt_errmsg, stmt))
shim fn bind_values(stmt: Stmt,
                    kinds: u8[]<=SVC_MAX_PARAMS, nkinds: i32 @len_of(kinds),
                    words: u64[]<=SVC_MAX_PARAMS, nwords: i32 @len_of(words),
                    data: bytes<=SVC_MAX_BIND_BYTES, ndata: size @len_of(data)) -> i32;

// Runs a statement to completion in one call and atomically: reset, clear_bindings, bind_values
// (the arrays are those of bind_values), then sqlite3_step until it stops, then changes64 and
// last_insert_rowid. Rows that the statement produces are discarded. A failure at any of these steps
// is the failure of the call, so a statement never runs with half of its parameters bound.
// The result code is SQLITE_DONE on success.
@error(status, ok(SQLITE_DONE), detail(stmt_errmsg, stmt))
shim fn exec_stmt(stmt: Stmt,
                  kinds: u8[]<=SVC_MAX_PARAMS, nkinds: i32 @len_of(kinds),
                  words: u64[]<=SVC_MAX_PARAMS, nwords: i32 @len_of(words),
                  data: bytes<=SVC_MAX_BIND_BYTES, ndata: size @len_of(data),
                  out changes: i64, out last_rowid: i64) -> i32;

// ---- Results ---------------------------------------------------------------------------------

fn sqlite3_column_count(stmt: Stmt) -> i32;
fn sqlite3_column_name(stmt: Stmt, n: i32) -> str<=SVC_MAX_NAME @nullable;
fn sqlite3_column_decltype(stmt: Stmt, n: i32) -> str<=SVC_MAX_NAME @nullable;

// Parameter count, parameter names, read-only flag, column names and declared types in one call.
// A name longer than SVC_MAX_NAME bytes, or a total above SVC_INFO_BOUND, is an application status
// (SVC_STATUS_NAME_TOO_LONG, SVC_STATUS_META_TOO_LARGE) and the call has no other effect.
shim fn stmt_info(stmt: Stmt) -> StmtMeta @max_out(SVC_INFO_BOUND);

// Steps the statement and returns up to max rows (0: SVC_DEFAULT_FETCH_ROWS; above SVC_MAX_FETCH_ROWS:
// that limit). The batch ends at max rows, when fewer than a row's worst case of bytes is left under
// the response bound, after a row that has a BigText or BigBlob cell, when the statement is done, or
// when sqlite3_step fails. The first call on a statement steps first, so a statement that has not
// been stepped is the precondition; after rc is SQLITE_DONE or an error, call sqlite3_reset before
// the next fetch_rows (a further step would run the statement again).
shim fn fetch_rows(stmt: Stmt, max: i32) -> Rows @max_out(SVC_FETCH_BOUND);

// Reads cap bytes at offset of the TEXT or BLOB value of column col in the row the statement is
// positioned on: after a fetch_rows whose last row had a BigText or BigBlob cell, and before the
// next step. n is the number of bytes returned (fewer than cap at the end; 0 at offset == length).
// SQLITE_RANGE: col is out of range, the statement is not on a row, the value is not text or blob, or
// offset is beyond its end. A call is idempotent, so reads of one cell may be pipelined.
@error(status, ok(SQLITE_OK), detail(stmt_errmsg, stmt))
shim fn column_chunk(stmt: Stmt, col: i32, offset: u64,
                     out dst: bytes<=SVC_MAX_CHUNK, cap: size @len_of(dst), out n: size @len_of(dst)) -> i32;

// ---- Declared for the server only (error detail) ----------------------------------------------

// The message of the connection (never NULL).
@allow(server) shim fn db_errmsg(db: Db) -> str<=SVC_MAX_NAME;
// The message of the connection that owns the statement.
@allow(server) shim fn stmt_errmsg(stmt: Stmt) -> str<=SVC_MAX_NAME;
// db_errmsg, or the text of the SVC_SQL_* failure that prepare_one just reported.
@allow(server) shim fn prep_errmsg(db: Db) -> str<=SVC_MAX_NAME;
